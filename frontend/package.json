{
  "name": "camera-path-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "api:generate": "orval --config orval.config.ts && node scripts/generate-api-schemas.mjs && prettier --write apps/host/src/adapters/api/generated packages/contracts/src/api",
    "api:check": "npm run api:generate && git diff --exit-code -- apps/host/src/adapters/api/generated packages/contracts/src/api packages/contracts/src/api-schemas.json && test -z \"$(git ls-files --others --exclude-standard apps/host/src/adapters/api/generated packages/contracts/src/api packages/contracts/src/api-schemas.json)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "graph:generate": "node scripts/generate-contract-graph.mjs",
    "graph:check": "node scripts/generate-contract-graph.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "3dgs-tile-webgpu": "github:vinneyto/3dgs_tile_webgpu#49267c4ba10c71539525bb2d1215045a4dedd01c",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "^20.14.0",
    "orval": "^8.41.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wgsl_reflect": "^1.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/contracts",
    "packages/extension-api",
    "packages/ui-kit",
    "packages/scene-runtime",
    "packages/trajectory-math",
    "packages/features/*"
  ]
}
