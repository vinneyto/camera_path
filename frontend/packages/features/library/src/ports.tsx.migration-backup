"use client";
import type {ReactNode} from "react";
import {useData,useDataQuery,useRequestAction} from "@camera-path/extension-api";
import {manifest} from "./manifest";
import {libraryAsset,libraryCatalog,projectPermissions} from "@camera-path/contracts/host-data";
export function EditorOnly({children,fallback=null}:{children:ReactNode;fallback?:ReactNode}) {return useData(manifest,projectPermissions).canEdit?children:fallback;}
export function useGetLibraryAsset(_id?:string) {return useDataQuery(manifest,libraryAsset);}
export function useListLibraryAssets() {return useDataQuery(manifest,libraryCatalog);}
