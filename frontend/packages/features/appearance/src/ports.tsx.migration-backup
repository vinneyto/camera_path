"use client";
import type {ReactNode} from "react";
import {useData,useDataQuery,useRequestAction} from "@camera-path/extension-api";
import {manifest} from "./manifest";
import {themeState} from "@camera-path/contracts/host-data";
import {toggleTheme} from "@camera-path/contracts/host-requests";
export function useTheme() {const theme = useData(manifest, themeState); const toggle = useRequestAction(manifest, toggleTheme); return {theme,toggleTheme:()=>void toggle(undefined)};}
