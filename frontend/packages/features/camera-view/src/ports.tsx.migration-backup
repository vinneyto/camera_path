"use client";
import type {ReactNode} from "react";
import {useData,useDataQuery,useRequestAction} from "@camera-path/extension-api";
import {manifest} from "./manifest";
import {cameraMode} from "@camera-path/contracts/host-data";
import {setCameraMode} from "@camera-path/contracts/host-requests";
export function useCameraMode() {const mode = useData(manifest, cameraMode); const set = useRequestAction(manifest, setCameraMode); return { cameraMode: mode, setCameraMode: set };}
