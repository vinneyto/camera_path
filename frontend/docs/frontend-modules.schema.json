{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "camera_path frontend module map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "line", "column"],
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "file", "line", "column"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "package", "definition", "usages"],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "hook",
            "action",
            "store-selector",
            "store-hook",
            "store-snapshot",
            "api-hook"
          ]
        },
        "package": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/location"
        },
        "statePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "usages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          },
          "minItems": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "file", "line", "column"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "root",
        "entrypoint",
        "files",
        "slots",
        "actions",
        "selectors"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": ["host", "shared", "feature"]
        },
        "root": {
          "type": "string"
        },
        "entrypoint": {
          "type": ["string", "null"]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "$ref": "#/$defs/slotTree"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "slotTree": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/slotTree"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      ]
    }
  }
}
