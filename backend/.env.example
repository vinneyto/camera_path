# Optional override; the default remains ~/.camera-path/camera_path.sqlite3.
# CAMERA_PATH_DATABASE_URL=sqlite+aiosqlite:////absolute/path/camera_path.sqlite3
# CAMERA_PATH_LIBRARY_DIRECTORY=/absolute/path/library
# Default: local. S3 requires: uv sync --extra aws
# CAMERA_PATH_AWS_LIBRARY_STORAGE=s3
# CAMERA_PATH_AWS_S3_BUCKET=camera-path-library-d9f856354df8-992382434156
# CAMERA_PATH_AWS_S3_PREFIX=library/
# CAMERA_PATH_AWS_S3_URL_TTL_SECONDS=300
# CAMERA_PATH_AWS_REGION=us-east-1
# Choose a profile OR credentials (for local development); EC2 uses its IAM role.
# CAMERA_PATH_AWS_PROFILE=camera-path-backend-d9f856354df8
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
CAMERA_PATH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAMERA_PATH_OPENAI_MODEL=gpt-5.6-luna
# Shared guest profile key; retains M2 settings, independent of editor identity.
# CAMERA_PATH_DEV_USER_ID=dev-user
# OPENAI_API_KEY=

# Generate a random secret (at least 32 bytes); never commit the actual value.
# CAMERA_PATH_JWT_SECRET=
# CAMERA_PATH_JWT_TTL_SECONDS=28800
