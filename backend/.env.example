# Optional override; the default remains ~/.camera-path/camera_path.sqlite3.
# CAMERA_PATH_DATABASE_URL=sqlite+aiosqlite:////absolute/path/camera_path.sqlite3
# CAMERA_PATH_LIBRARY_DIRECTORY=/absolute/path/library
# Default: local. S3 requires: uv sync --extra aws
# CAMERA_PATH_AWS_LIBRARY_STORAGE=s3
# CAMERA_PATH_AWS_S3_BUCKET=camera-path-library-d9f856354df8-992382434156
# CAMERA_PATH_AWS_S3_PREFIX=library/
# CAMERA_PATH_AWS_S3_URL_TTL_SECONDS=300
# CAMERA_PATH_AWS_REGION=us-east-1
# Choose a profile OR credentials (for local development); EC2 uses its IAM role.
# CAMERA_PATH_AWS_PROFILE=camera-path-backend-d9f856354df8
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
CAMERA_PATH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAMERA_PATH_OPENAI_MODEL=gpt-5.6-luna
CAMERA_PATH_OPENAI_IMAGE_MODEL=gpt-image-1.5
# 2D jobs: painter (default; local inference CLI), openai (explicit opt-in), or none.
CAMERA_PATH_IMAGE_GENERATION_PROVIDER=painter
# Browser origin for CLI device authorization. Use the deployment's actual frontend origin.
CAMERA_PATH_CLI_WEB_URL=http://127.0.0.1:3000
# CAMERA_PATH_PAINTER_MODEL=black-forest-labs/FLUX.2-klein-4B
# CAMERA_PATH_PAINTER_REVISION=e7b7dc27f91deacad38e78976d1f2b499d76a294
# Shared guest profile key; retains M2 settings, independent of editor identity.
# CAMERA_PATH_DEV_USER_ID=dev-user
# OPENAI_API_KEY=

# Generate a random secret (at least 32 bytes); never commit the actual value.
# CAMERA_PATH_JWT_SECRET=
# CAMERA_PATH_JWT_TTL_SECONDS=28800

# Independent library imports can use SQS. Local inference jobs use the SQLite queue.
CAMERA_PATH_MESSAGE_QUEUE=none
CAMERA_PATH_MESSAGE_QUEUE_MAX_ATTEMPTS=5
# SQS visibility only; renewed by the SQS adapter during processing.
CAMERA_PATH_MESSAGE_QUEUE_LEASE_SECONDS=60
# CAMERA_PATH_GENERATION_DEFAULT_ROTATION_DEG=[180,0,0]
CAMERA_PATH_LIBRARY_IMPORT_SOURCES={}
# Dev example: {"incoming":{"driver":"local","root":"/absolute/generated"}}
# AWS example: {"incoming":{"driver":"s3","bucket":"producer-output","prefix":"ready/"}}
# CAMERA_PATH_AWS_SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/imports
# CAMERA_PATH_AWS_SQS_FAILURE_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/import-failures
