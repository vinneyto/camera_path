  {
    "type": "function",
    "name": "set_lidar_timeline",
    "description": "Enable LiDAR or update its static angular sampling settings. There is exactly one presence key at position zero, with no animated settings. Null preserves the existing setting or uses its default when enabling.",
    "parameters": {
      "type": "object",
      "properties": {
